{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "lib/**/*", "lib/**/*.vue"],
  "exclude": ["lib/**/*.spec.ts"],
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["lib/*"]
    }
  }
}
